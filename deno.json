{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "tasks": {
    "test": "deno test --allow-all --ignore=test/acceptance.test.ts",
    "test:shell": "bash test/setup.test.sh",
    "start": "deno run --allow-net --allow-env --allow-read src/api/server.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/api/server.ts",
    "ingest": "deno run --allow-net --allow-env --allow-read src/ingest/index.ts",
    "test:acceptance": "deno test --allow-all test/acceptance.test.ts"
  },
  "imports": {
    "@qdrant/js-client-rest": "npm:@qdrant/js-client-rest@^1.17.0",
    "unified": "npm:unified@^11.0.0",
    "remark-parse": "npm:remark-parse@^11.0.0",
    "mdast": "npm:@types/mdast",
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing/mock": "jsr:@std/testing@1/mock"
  }
}